# Endereço da API visto pelo celular ("localhost" no aparelho é o próprio aparelho):
# - emulador Android: http://10.0.2.2:5158/v1
# - celular físico: http://<IP do computador na rede>:5158/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:5158/v1

# Chave do MapTiler (plano grátis em cloud.maptiler.com) para o fundo do mapa
EXPO_PUBLIC_MAPTILER_CHAVE=
