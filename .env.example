# Variáveis de ambiente da API para produção (em desenvolvimento, appsettings.Development.json já basta).
# Defina no servidor; nunca suba valores reais para o repositório.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=descartaai;Username=descartaai;Password=TROQUE-ESTA-SENHA
Cors__Origens=https://descartaai.com.br
Banco__MigrarAoIniciar=false
Swagger__Habilitado=false
Limite__RequisicoesPorMinuto=120
# Identificação por foto (Google AI Studio). Sem a chave, POST /v1/identificacoes responde 503.
Gemini__ChaveApi=
Gemini__Modelo=gemini-2.5-flash
Limite__IdentificacoesPorMinuto=10
# IP do proxy reverso (nginx/Cloudflare) para identificar o IP real do usuário
Proxy__Confiaveis__0=127.0.0.1
# Login de parceiros e admin: chave com 32+ caracteres (openssl rand -hex 32)
Jwt__Chave=
# Primeiro administrador (criado só se não houver nenhum; apague depois do primeiro login)
Admin__Email=
Admin__Senha=
