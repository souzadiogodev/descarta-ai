# Copie para .env no servidor (nunca suba o .env para o Git).

# Senha do banco: gere uma forte, por exemplo: openssl rand -hex 24
DB_SENHA=

# Domínio da API. Enquanto descartaai.com.br não estiver registrado, use o sslip.io,
# que aponta para o IP do servidor sem configurar DNS (troque 203.0.113.10 pelo IP do VPS):
API_DOMINIO=api.203.0.113.10.sslip.io
# Depois do registro: API_DOMINIO=api.descartaai.com.br

# Endereço do site (Cloudflare Pages), para o CORS. Vários separados por vírgula.
SITE_ORIGEM=https://descarta-ai.pages.dev

# Identificação por foto (aistudio.google.com/apikey). Vazio = a API responde 503 nessa função.
GEMINI_CHAVE=
GEMINI_MODELO=gemini-2.5-flash

# Assinatura dos logins (parceiros e admin). Gere uma vez: openssl rand -hex 32
# Trocar a chave desconecta todo mundo.
JWT_CHAVE=

# Primeiro administrador: criado só se ainda não existir nenhum. Depois do primeiro login,
# pode apagar estas duas linhas. Use uma senha forte (12+ caracteres).
ADMIN_EMAIL=
ADMIN_SENHA=
